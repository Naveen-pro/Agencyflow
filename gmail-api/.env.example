# Run: node generate-key.js to create this
EMAIL_API_KEY=email_your_generated_key_here

# Gmail Account 1 (required)
# Get App Password: myaccount.google.com → Security → App passwords
GMAIL_ACCOUNT_1=youragency@gmail.com
GMAIL_PASSWORD_1=abcdabcdabcdabcd

# Gmail Account 2 (optional — adds 500 more emails/day)
GMAIL_ACCOUNT_2=youragency2@gmail.com
GMAIL_PASSWORD_2=efghefghefghefgh

# Gmail Account 3 (optional — adds another 500/day)
# GMAIL_ACCOUNT_3=youragency3@gmail.com
# GMAIL_PASSWORD_3=ijklijklijklijkl

# Redis (must be same Redis as AgencyFlow backend)
REDIS_URL=redis://localhost:6379

PORT=7003
